# Copy to deploy/.env and fill in. Generate secrets with: openssl rand -hex 32

# --- Images (CI sets IMAGE_TAG on deploy; GHCR_OWNER = lowercase GitHub owner) ---
IMAGE_TAG=latest
GHCR_OWNER=your-github-owner

# --- Domain (Caddy serves app.$DOMAIN, api.$DOMAIN, admin.$DOMAIN) ---
DOMAIN=example.com

# --- Postgres ---
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-32
POSTGRES_USER=deepkhata
POSTGRES_DB=deepkhata

# --- Application ---
APP_NAME=DeepKhata
APP_VERSION=
PORT=5000
# Compose-internal host "postgres"; keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql://deepkhata:change-me-generate-with-openssl-rand-hex-32@postgres:5432/deepkhata
DIRECT_URL=postgresql://deepkhata:change-me-generate-with-openssl-rand-hex-32@postgres:5432/deepkhata

# --- Better Auth (secret must be at least 32 chars or the API refuses to boot) ---
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
# Public URL of the API (https://api.example.com)
BETTER_AUTH_URL=https://api.example.com

# --- URLs / CORS / cookies ---
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Parent domain so the session cookie is shared by api./app./admin. Leave empty for host-only.
COOKIE_DOMAIN=.example.com
# PUBLIC_API_URL (https://api.example.com) is a GitHub Actions secret, not set here:
# it is baked into the client/admin builds as NEXT_PUBLIC_API_URL.

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
SMTP_FROM=noreply@example.com

# --- Image hosting (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# --- Object storage / backups (Cloudflare R2) ---
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=deepkhata-backups

# --- Cache (optional; leave unset, no Redis in this stack) ---
# REDIS_URL=

# Express trusts X-Forwarded-For only from this proxy (Caddy on the compose network)
TRUST_PROXY=172.16.0.0/12

# Mail branding (MailService). SMTP_FROM is not read; set MAIL_FROM ("Name <addr>").
MAIL_FROM=
MAIL_LOGO_URL=

# Agency (billing PDFs, signup alerts, trial emails)
AGENCY_NAME=
AGENCY_ADDRESS=
AGENCY_NTN=
AGENCY_BANK_DETAILS=
AGENCY_JAZZCASH=
AGENCY_EASYPAISA=
AGENCY_ALERT_EMAIL=
AGENCY_PAY_URL=
