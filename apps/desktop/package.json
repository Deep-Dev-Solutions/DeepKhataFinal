{
  "name": "desktop",
  "version": "0.0.1",
  "private": true,
  "description": "DeepKhata Shop Server desktop edition (Electron)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "stage": "node scripts/stage.js",
    "dist": "npm run build && npm run stage && electron-builder --win nsis --x64",
    "dist:dir": "npm run build && npm run stage && electron-builder --dir"
  },
  "dependencies": {
    "embedded-postgres": "^18.6.0-beta.19"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.deepkhata.shopserver",
    "productName": "DeepKhata",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/embedded-postgres/**",
      "**/node_modules/@embedded-postgres/**"
    ],
    "extraResources": [
      {
        "from": "stage/server",
        "to": "server"
      },
      {
        "from": "stage/client",
        "to": "client"
      },
      {
        "from": "build/pgtools",
        "to": "pgtools"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": "scripts/sign.js"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
