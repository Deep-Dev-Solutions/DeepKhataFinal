// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  extensions = [pg_trgm]
}

model Business {
  id       String  @id @default(uuid())
  name     String
  email    String?
  slug     String  @unique
  currency String  @default("PKR")
  industry String?
  teamSize String?
  phone    String?
  address  String?
  ownerId  String
  logoUrl  String?

  // Agency Billing / Subscription Tracking
  status               BusinessStatus @default(ACTIVE)
  subscriptionExpiresAt DateTime?

  owner       User         @relation("BusinessOwner", fields: [ownerId], references: [id])
  users       User[]       @relation("BusinessUsers")
  customers   Customer[]
  products    Product[]
  orders      Order[]
  invitations Invitation[]
  categories  Category[]
  vendors     Vendor[]

  branches           Branch[]
  cabinets           Cabinet[]
  transactions       Transaction[]
  expenses           Expense[]
  registerSessions   CashRegisterSession[]
  inventoryMovements InventoryMovement[]
  billingLogs        AgencyBillingLog[]
  khataEntries       KhataEntry[]
  notifications      Notification[]
  stockReservations  StockReservation[]
  stockTransfers     StockTransferRequest[]

  defaultReceivableDays Int @default(7)
  defaultPayableDays    Int @default(15)

  createdAt DateTime @default(now())
}

model AgencyBillingLog {
  id          String   @id @default(uuid())
  businessId  String
  amount      Decimal @db.Decimal(14, 2)
  paymentDate DateTime
  notes       String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([businessId])
}

model Branch {
  id       String  @id @default(uuid())
  name     String
  location String?
  phone    String?

  deletedAt DateTime?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  cabinets         Cabinet[]
  products         Product[]
  categories       Category[]
  productInstances ProductInstance[]
  expenses         Expense[]
  registerSessions CashRegisterSession[]
  orders           Order[]
  khataEntries     KhataEntry[]
  inventoryMovements InventoryMovement[]
  stockReservations  StockReservation[]
  transfersFrom      StockTransferRequest[] @relation("TransferFrom")
  transfersTo        StockTransferRequest[] @relation("TransferTo")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([businessId, updatedAt])
}

model User {
  id        String  @id @default(uuid())
  name      String
  email     String  @unique
  password  String
  role      Role    @default(OWNER)
  phone     String?
  avatarUrl String?

  failedAttempts Int       @default(0)
  lockoutUntil   DateTime?

  businessId String?
  business   Business? @relation("BusinessUsers", fields: [businessId], references: [id])

  ownedBusinesses    Business[]            @relation("BusinessOwner")
  createdOrders      Order[]               @relation("OrderCreator")
  receivedPayments   Payment[]             @relation("PaymentReceiver")
  createdExpenses    Expense[]             @relation("ExpenseCreator")
  openedRegisters    CashRegisterSession[] @relation("RegisterOpener")
  closedRegisters    CashRegisterSession[] @relation("RegisterCloser")
  inventoryMovements InventoryMovement[]
  notifications      Notification[]

  createdAt DateTime @default(now())
}

model Invitation {
  id         String   @id @default(uuid())
  email      String
  role       Role
  token      String   @unique
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([email, businessId])
}

model Customer {
  id    String @id @default(uuid())
  name  String
  phone String

  shopName   String?
  email      String?
  address    String?
  cnicNumber String?

  // Anti-Fraud System
  creditLimit    Decimal @db.Decimal(14, 2)   @default(0)
  isDefaulter    Boolean @default(false)
  guarantorPhone String?
  paymentTermsDays Int?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders     Order[]
  khataEntries KhataEntry[]
  createdAt  DateTime @default(now())

  deletedAt DateTime?
  updatedAt DateTime @updatedAt

  @@index([businessId, updatedAt])
  @@index([businessId, phone])
}

model Cabinet {
  id       String  @id @default(uuid())
  name     String
  rack     String?
  shelf    String?
  bin      String?
  location String? // e.g., Rack -> Shelf -> Bin

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  instances ProductInstance[]
  createdAt DateTime          @default(now())

  movements InventoryMovement[]

  deletedAt DateTime?
  updatedAt DateTime @updatedAt

  @@index([businessId, updatedAt])
}

model Product {
  id               String  @id @default(uuid())
  name             String
  sku              String
  basePrice        Decimal @db.Decimal(14, 2)
  defaultCostPrice Decimal? @db.Decimal(14, 2)
  deletedAt        DateTime?

  partNumber        String?
  aliases           String[] @default([])
  compatibleWith    String[] @default([])
  minSalePrice      Decimal? @db.Decimal(14, 2)
  lowStockThreshold Int?
  searchText        String   @default("")

  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  orderItems       OrderItem[]
  instances        ProductInstance[]
    movements        InventoryMovement[]

  updatedAt DateTime @updatedAt

  @@index([businessId, updatedAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([businessId, partNumber])
}

model ProductInstance {
  id        String  @id @default(uuid())
  productId String
  cabinetId String?
  branchId  String
  vendorId  String?

  unitCost     Decimal? @db.Decimal(14, 2)

  status       InstanceStatus @default(AVAILABLE) // For MEMO locks
  condition    ItemCondition  @default(ORIGINAL_PULL)
  serialNumber String?
  photoUrl     String?
  notes        String?

  reservations  StockReservation[]
  transferItems StockTransferItem[]

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cabinet Cabinet? @relation(fields: [cabinetId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  vendor  Vendor? @relation(fields: [vendorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status, branchId])
  @@index([branchId, updatedAt])
}

model Category {
  id         String @id @default(uuid())
  name       String
  businessId String

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  products Product[]

  @@unique([name, branchId])

  deletedAt DateTime?
  updatedAt DateTime @updatedAt

  @@index([businessId, updatedAt])
}

model InventoryMovement {
  id            String             @id @default(uuid())
  productId     String
  cabinetId     String?
  quantity      Int
  direction     InventoryDirection // IN (restock) | OUT (sale/return/adjust)
  referenceType String? // ORDER | RESTOCK | RETURN | ADJUSTMENT
  referenceId   String?
  notes         String?
  userId        String
  businessId    String
  vendorId      String?
  fromCondition ItemCondition?
  toCondition   ItemCondition      @default(ORIGINAL_PULL)
  branchId      String?
  createdAt     DateTime           @default(now())

  product  Product  @relation(fields: [productId], references: [id])
  cabinet  Cabinet? @relation(fields: [cabinetId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])
  vendor   Vendor?  @relation(fields: [vendorId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([productId])
  @@index([businessId])
  @@index([createdAt])
}

model Order {
  id            String        @id @default(uuid())
  customerId    String?
  businessId    String
  branchId      String?
  discount      Decimal @db.Decimal(14, 2)         @default(0)
  status        OrderStatus
  paymentStatus PaymentStatus @default(UNPAID)
  totalAmount   Decimal @db.Decimal(14, 2)
  createdBy     String?
  orderNumber   Int           @default(autoincrement())
  walkInName    String?
  walkInPhone   String?
  dueDate       DateTime?

  creator   User?       @relation("OrderCreator", fields: [createdBy], references: [id])
  customer  Customer?   @relation(fields: [customerId], references: [id])
  business  Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]
  createdAt DateTime    @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, customerId])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String?
  quantity    Int
  price       Decimal @db.Decimal(14, 2)
  isService   Boolean @default(false)
  serviceName String?
  notes       String?
  priceOverrideReason String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Payment {
  id         String        @id @default(uuid())
  orderId    String
  amount     Decimal @db.Decimal(14, 2)
  method     PaymentMethod
  receivedBy String

  receiver  User     @relation("PaymentReceiver", fields: [receivedBy], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Transaction {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  referenceId String?
  type        String
  description String?
  dueDate     DateTime?

  postings  Posting[]
  expense   Expense?
  createdAt DateTime  @default(now())

  @@index([businessId, type, createdAt])
}

model Posting {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  accountId   String // Could be Customer ID or Ledger Account ID
  accountType String // e.g., CUSTOMER, CASH, REVENUE, INVENTORY
  amount      Decimal @db.Decimal(14, 2) // Positive for debit, negative for credit

  createdAt DateTime @default(now())

  @@index([accountId, accountType])
  @@index([transactionId])
}

enum OrderStatus {
  ESTIMATE
  MEMO
  FINAL
  COMPLETED
  PENDING
  CANCELLED
  RETURNED
}

enum ItemCondition {
  ORIGINAL_PULL
  COPY
  MINOR_SCRATCHES
  WORKING
  DEAD_DONOR
  DEFECTIVE
}

enum InstanceStatus {
  AVAILABLE
  MEMO_LOCKED
  SOLD
  DEFECTIVE
  RETURNED_WORKING
  RETURNED_DEFECTIVE
  CONSUMED
  RESERVED
  IN_TRANSIT
}

enum InventoryDirection {
  IN
  OUT
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  STAFF
}

enum PaymentMethod {
  CASH
  BANK
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum BusinessStatus {
  ACTIVE
  READ_ONLY
  SUSPENDED
}

model Expense {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  amount      Decimal @db.Decimal(14, 2)
  category    String // e.g., CHAI_REFRESHMENT, DELIVERY_RIDER, REPAIR_PARTS, SUPPLIES, UTILITIES, OTHER
  description String?

  createdById String?
  createdBy   User?   @relation("ExpenseCreator", fields: [createdById], references: [id])

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  sessionId String?
  session   CashRegisterSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model CashRegisterSession {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  openedById String
  openedBy   User    @relation("RegisterOpener", fields: [openedById], references: [id])
  closedById String?
  closedBy   User?   @relation("RegisterCloser", fields: [closedById], references: [id])

  status RegisterStatus @default(OPEN)

  openingBalance Decimal @db.Decimal(14, 2)   @default(0)
  cashSales      Decimal @db.Decimal(14, 2)   @default(0)
  cashExpenses   Decimal @db.Decimal(14, 2)   @default(0)
  expectedCash   Decimal @db.Decimal(14, 2)   @default(0)
  actualCash     Decimal? @db.Decimal(14, 2)
  difference     Decimal? @db.Decimal(14, 2)
  notes          String?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RegisterStatus {
  OPEN
  CLOSED
}

model Vendor {
  id           String  @id @default(uuid())
  businessName String
  contactName  String?
  phone        String?
  address      String?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  productInstances   ProductInstance[]
  inventoryMovements InventoryMovement[]
  khataEntries       KhataEntry[]

  createdAt DateTime @default(now())

  deletedAt DateTime?
  updatedAt DateTime @updatedAt

  @@index([businessId, updatedAt])
}

model LoginAttempt {
  id           String    @id @default(uuid())
  ip           String    @unique
  attempts     Int       @default(0)
  lockoutUntil DateTime?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  @@index([ip])
}


model RevokedToken {
  jti       String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum KhataDirection {
  RECEIVABLE
  PAYABLE
}

enum KhataPartyType {
  CUSTOMER
  VENDOR
  OTHER
}

enum KhataStatus {
  OPEN
  PARTIAL
  SETTLED
  WRITTEN_OFF
}

model KhataEntry {
  id            String         @id @default(uuid())
  businessId    String
  branchId      String?
  direction     KhataDirection
  partyType     KhataPartyType
  customerId    String?
  vendorId      String?
  partyName     String
  partyPhone    String?
  amount        Decimal        @db.Decimal(14, 2)
  settledAmount Decimal        @default(0) @db.Decimal(14, 2)
  counterAccount String        @default("ASSET")
  dueDate       DateTime
  note          String?
  status        KhataStatus    @default(OPEN)
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vendor   Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([businessId, direction, status, dueDate])
}

model PromiseToPay {
  id           String   @id @default(uuid())
  businessId   String
  entityType   String
  entityId     String
  kind         String   @default("PROMISE")
  promisedDate DateTime
  note         String?
  createdById  String
  createdAt    DateTime @default(now())

  @@index([businessId, entityType, entityId])
}

model DueReminder {
  id         String   @id @default(uuid())
  businessId String
  entityType String
  entityId   String
  channel    String
  sentById   String?
  createdAt  DateTime @default(now())

  @@index([businessId, entityType, entityId])
}

model Notification {
  id         String    @id @default(uuid())
  businessId String
  userId     String
  branchId   String?
  type       String
  title      String
  body       String
  link       String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, userId, readAt])
  @@index([userId, createdAt])
}

model NotificationSetting {
  id         String   @id @default(uuid())
  businessId String
  userId     String?
  rules      Json
  digestTime String   @default("10:00")
  recipients String   @default("OWNER_AND_MANAGERS")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, userId])
}

model NotificationLog {
  id         String   @id @default(uuid())
  businessId String
  ruleKey    String
  entityId   String
  fireDate   DateTime @db.Date
  createdAt  DateTime @default(now())

  @@unique([ruleKey, entityId, fireDate])
  @@index([businessId])
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONVERTED
}

enum TransferStatus {
  REQUESTED
  DISPATCHED
  RECEIVED
  CANCELLED
}

model StockReservation {
  id            String            @id @default(uuid())
  businessId    String
  instanceId    String
  branchId      String
  customerName  String
  customerPhone String?
  expiresAt     DateTime
  status        ReservationStatus @default(ACTIVE)
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instance ProductInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  branch   Branch          @relation(fields: [branchId], references: [id])

  @@index([businessId, status, expiresAt])
  @@index([instanceId])
}

model StockTransferRequest {
  id             String         @id @default(uuid())
  businessId     String
  fromBranchId   String
  toBranchId     String
  status         TransferStatus @default(REQUESTED)
  note           String?
  requestedById  String
  dispatchedById String?
  receivedById   String?
  requestedAt    DateTime       @default(now())
  dispatchedAt   DateTime?
  receivedAt     DateTime?
  cancelledAt    DateTime?
  updatedAt      DateTime       @updatedAt

  items StockTransferItem[]

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fromBranch Branch   @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch   @relation("TransferTo", fields: [toBranchId], references: [id])

  @@index([businessId, status])
  @@index([toBranchId, status])
  @@index([fromBranchId, status])
}

model StockTransferItem {
  id         String @id @default(uuid())
  transferId String
  instanceId String

  transfer StockTransferRequest @relation(fields: [transferId], references: [id], onDelete: Cascade)
  instance ProductInstance      @relation(fields: [instanceId], references: [id])

  @@unique([transferId, instanceId])
}
