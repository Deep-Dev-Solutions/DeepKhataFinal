# Application
APP_NAME=DeepKhata
APP_VERSION=
PORT=5000

# Database (docker-compose.dev.yml). If host port 5432 is taken, export POSTGRES_PORT=5433
# before `npm run db:up` and change the port in these URLs.
DATABASE_URL=postgresql://deepkhata:deepkhata@localhost:5432/deepkhata
DIRECT_URL=postgresql://deepkhata:deepkhata@localhost:5432/deepkhata
DATABASE_URL_TEST=postgresql://deepkhata:deepkhata@localhost:5432/deepkhata_test

# JWT Tokens
ACCESS_TOKEN_SECRET=change-me-access-secret-key
REFRESH_TOKEN_SECRET=change-me-refresh-secret-key
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Frontend URLs
FRONTEND_URL=http://localhost:3000

# Email / SMTP. Leave SMTP_HOST and RESEND_API_KEY unset locally: the mailer then
# falls back to Mailpit on 127.0.0.1:1025 (UI at http://localhost:8025).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=change-me
# SMTP_PASS=change-me
# RESEND_API_KEY=change-me
SMTP_FROM=noreply@deepkhata.local

# Image hosting (Cloudinary)
CLOUDINARY_CLOUD_NAME=change-me-cloudinary-cloud-name
CLOUDINARY_API_KEY=change-me-cloudinary-api-key
CLOUDINARY_API_SECRET=change-me-cloudinary-api-secret

# Cache (optional, Redis support)
# REDIS_URL=redis://localhost:6379
E2E_DATABASE_URL=postgresql://deepkhata:deepkhata@localhost:5432/deepkhata_e2e

# Test-only endpoints (POST /reminders/run). Never enable in production.
ENABLE_TEST_ENDPOINTS=false

# Comma-separated allowed browser origins (default: localhost:3000/3001 + legacy Vercel hosts)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Trusted reverse proxy for X-Forwarded-For (default: loopback)
# TRUST_PROXY=172.16.0.0/12  # docker network of the Caddy proxy in production
