# Application
APP_NAME=DeepKhata
APP_VERSION=
PORT=5000

# Database (docker-compose.dev.yml). If host port 5432 is taken, export POSTGRES_PORT=5433
# before `npm run db:up` and change the port in these URLs.
DATABASE_URL=postgresql://deepkhata:deepkhata@localhost:5432/deepkhata
DIRECT_URL=postgresql://deepkhata:deepkhata@localhost:5432/deepkhata
DATABASE_URL_TEST=postgresql://deepkhata:deepkhata@localhost:5432/deepkhata_test

# Better Auth (sessions). Secret must be at least 32 characters or the server refuses to boot.
BETTER_AUTH_SECRET=change-me-better-auth-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:5000

# Frontend URLs
FRONTEND_URL=http://localhost:3000

# Email / SMTP. Leave SMTP_HOST and RESEND_API_KEY unset locally: the mailer then
# falls back to Mailpit on 127.0.0.1:1025 (UI at http://localhost:8025).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=change-me
# SMTP_PASS=change-me
# RESEND_API_KEY=change-me
SMTP_FROM=noreply@deepkhata.local

# Image hosting (Cloudinary)
CLOUDINARY_CLOUD_NAME=change-me-cloudinary-cloud-name
CLOUDINARY_API_KEY=change-me-cloudinary-api-key
CLOUDINARY_API_SECRET=change-me-cloudinary-api-secret

# Cache (optional, Redis support)
# REDIS_URL=redis://localhost:6379
E2E_DATABASE_URL=postgresql://deepkhata:deepkhata@localhost:5432/deepkhata_e2e

# Test-only endpoints (POST /reminders/run). Never enable in production.
ENABLE_TEST_ENDPOINTS=false

# Comma-separated allowed browser origins (default: localhost:3000/3001 + legacy Vercel hosts)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Trusted reverse proxy for X-Forwarded-For (default: loopback)
# TRUST_PROXY=172.16.0.0/12  # docker network of the Caddy proxy in production

# Mail branding (MailService). SMTP_FROM is not read; set MAIL_FROM ("Name <addr>").
MAIL_FROM=
MAIL_LOGO_URL=

# Agency (billing PDFs, signup alerts, trial emails)
AGENCY_NAME=
AGENCY_ADDRESS=
AGENCY_NTN=
AGENCY_BANK_DETAILS=
AGENCY_JAZZCASH=
AGENCY_EASYPAISA=
AGENCY_ALERT_EMAIL=
AGENCY_PAY_URL=

# Desktop licence signing (Ed25519 PKCS8 private key in PEM format, newlines escaped as \n)
# LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Rate limiting (global ThrottlerGuard, per route and client IP; Better Auth /api/auth/* has its own limiter)
# THROTTLE_LIMIT=100          # requests per window on every route (also Better Auth's default per-path max)
# THROTTLE_TTL_MS=60000       # window length in ms
# THROTTLE_AUTH_LIMIT=10      # login, register, agency-login, resend-verification, change-password, Better Auth sign-in (password reset/verification mail use half)
# THROTTLE_PUBLIC_LIMIT=30    # unauthenticated token routes: team invite/join, public invoices
# THROTTLE_FORCE=0            # 1 enables Better Auth's limiter under NODE_ENV=test (API tests only)
# Raise the limits above when running Playwright against a dev server (one IP, many logins).
