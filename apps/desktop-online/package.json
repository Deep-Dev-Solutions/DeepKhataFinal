{
  "name": "desktop-online",
  "version": "0.0.1",
  "private": true,
  "description": "DeepKhata Cloud desktop shell (Electron) — loads the hosted app, adds silent receipt printing and a cash-drawer kick",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.deepkhata.clouddesktop",
    "productName": "DeepKhata",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DeepKhata"
    }
  }
}
