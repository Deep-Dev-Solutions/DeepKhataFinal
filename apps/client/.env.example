# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_AGENCY_URL=http://localhost:3001
# Agency WhatsApp number for upgrade requests, digits only e.g. 923001234567
NEXT_PUBLIC_AGENCY_WHATSAPP=
# Cloudflare Turnstile site key (public). Empty hides the captcha widgets. Must match the API's TURNSTILE_SECRET_KEY.
# Always-pass test key for staging: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
