// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id       String  @id @default(uuid())
  name     String
  email    String?
  slug     String  @unique
  currency String  @default("PKR")
  industry String?
  teamSize String?
  phone    String?
  address  String?
  ownerId  String
  logoUrl  String?

  owner       User         @relation("BusinessOwner", fields: [ownerId], references: [id])
  users       User[]       @relation("BusinessUsers")
  customers   Customer[]
  products    Product[]
  orders      Order[]
  invitations Invitation[]
  categories  Category[]
  vendors     Vendor[]

  branches           Branch[]
  cabinets           Cabinet[]
  transactions       Transaction[]
  expenses           Expense[]
  registerSessions   CashRegisterSession[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
}

model Branch {
  id       String  @id @default(uuid())
  name     String
  location String?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  cabinets         Cabinet[]
  expenses         Expense[]
  registerSessions CashRegisterSession[]

  createdAt DateTime @default(now())
}

model User {
  id        String  @id @default(uuid())
  name      String
  email     String  @unique
  password  String
  role      Role    @default(OWNER)
  phone     String?
  avatarUrl String?

  businessId String?
  business   Business? @relation("BusinessUsers", fields: [businessId], references: [id])

  ownedBusinesses    Business[]            @relation("BusinessOwner")
  createdOrders      Order[]               @relation("OrderCreator")
  receivedPayments   Payment[]             @relation("PaymentReceiver")
  createdExpenses    Expense[]             @relation("ExpenseCreator")
  openedRegisters    CashRegisterSession[] @relation("RegisterOpener")
  closedRegisters    CashRegisterSession[] @relation("RegisterCloser")
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
}

model Invitation {
  id         String   @id @default(uuid())
  email      String
  role       Role
  token      String   @unique
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([email, businessId])
}

model Customer {
  id    String @id @default(uuid())
  name  String
  phone String

  shopName   String?
  email      String?
  address    String?
  cnicNumber String?

  // Anti-Fraud System
  creditLimit    Float   @default(0)
  isDefaulter    Boolean @default(false)
  guarantorPhone String?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders     Order[]
  createdAt  DateTime @default(now())
}

model Cabinet {
  id       String  @id @default(uuid())
  name     String
  location String? // e.g., Shop Location -> Rack -> Shelf -> Bin

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  instances ProductInstance[]
  createdAt DateTime          @default(now())

  movements InventoryMovement[]
}

model Product {
  id        String  @id @default(uuid())
  name      String
  sku       String?
  price     Float
  costPrice Float?
  stock     Int     @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]
  instances  ProductInstance[]
  movements  InventoryMovement[]
}

model ProductInstance {
  id        String  @id @default(uuid())
  productId String
  cabinetId String?

  condition    ItemCondition  @default(ORIGINAL_PULL)
  status       InstanceStatus @default(AVAILABLE) // For MEMO locks
  serialNumber String?

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cabinet Cabinet? @relation(fields: [cabinetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id         String @id @default(uuid())
  name       String
  businessId String

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([name, businessId])
}

model InventoryMovement {
  id            String             @id @default(uuid())
  productId     String
  cabinetId     String?
  fromCondition ItemCondition?
  toCondition   ItemCondition
  quantity      Int
  direction     InventoryDirection // IN (restock) | OUT (sale/return/adjust)
  referenceType String? // ORDER | RESTOCK | RETURN | ADJUSTMENT
  referenceId   String?
  notes         String?
  userId        String
  businessId    String
  createdAt     DateTime           @default(now())

  product  Product  @relation(fields: [productId], references: [id])
  cabinet  Cabinet? @relation(fields: [cabinetId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@index([productId])
  @@index([businessId])
  @@index([createdAt])
}

model Order {
  id            String        @id @default(uuid())
  customerId    String?
  businessId    String
  discount      Float         @default(0)
  status        OrderStatus
  paymentStatus PaymentStatus @default(UNPAID)
  totalAmount   Float
  createdBy     String?
  orderNumber   Int           @default(autoincrement())
  walkInName    String?
  walkInPhone   String?

  creator   User?       @relation("OrderCreator", fields: [createdBy], references: [id])
  customer  Customer?   @relation(fields: [customerId], references: [id])
  business  Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  payments  Payment[]
  createdAt DateTime    @default(now())
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String?
  quantity    Int
  price       Float
  isService   Boolean @default(false)
  serviceName String?
  notes       String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

model Payment {
  id         String        @id @default(uuid())
  orderId    String
  amount     Float
  method     PaymentMethod
  receivedBy String

  receiver  User     @relation("PaymentReceiver", fields: [receivedBy], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  referenceId String?
  type        String
  description String?

  postings  Posting[]
  expense   Expense?
  createdAt DateTime  @default(now())
}

model Posting {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  accountId   String // Could be Customer ID or Ledger Account ID
  accountType String // e.g., CUSTOMER, CASH, REVENUE, INVENTORY
  amount      Float // Positive for debit, negative for credit

  createdAt DateTime @default(now())
}

enum OrderStatus {
  ESTIMATE
  MEMO
  FINAL
  CANCELLED
  RETURNED
}

enum ItemCondition {
  ORIGINAL_PULL
  COPY
  MINOR_SCRATCHES
  WORKING
  DEAD_DONOR
  DEFECTIVE
}

enum InstanceStatus {
  AVAILABLE
  MEMO_LOCKED
  SOLD
  DEFECTIVE
  RETURNED_WORKING
  RETURNED_DEFECTIVE
  CONSUMED
}

enum InventoryDirection {
  IN
  OUT
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum PaymentMethod {
  CASH
  BANK
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model Expense {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  amount      Float
  category    String // e.g., CHAI_REFRESHMENT, DELIVERY_RIDER, REPAIR_PARTS, SUPPLIES, UTILITIES, OTHER
  description String?

  createdById String?
  createdBy   User?   @relation("ExpenseCreator", fields: [createdById], references: [id])

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  sessionId String?
  session   CashRegisterSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model CashRegisterSession {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  openedById String
  openedBy   User    @relation("RegisterOpener", fields: [openedById], references: [id])
  closedById String?
  closedBy   User?   @relation("RegisterCloser", fields: [closedById], references: [id])

  status RegisterStatus @default(OPEN)

  openingBalance Float   @default(0)
  cashSales      Float   @default(0)
  cashExpenses   Float   @default(0)
  expectedCash   Float   @default(0)
  actualCash     Float?
  difference     Float?
  notes          String?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RegisterStatus {
  OPEN
  CLOSED
}

model Vendor {
  id           String  @id @default(uuid())
  businessName String
  contactName  String?
  phone        String?
  address      String?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
